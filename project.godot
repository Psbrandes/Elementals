; Engine configuration file.
; Configurações do GDD, seção 8 (Tecnologia).

config_version=5

[application]

config/name="Elementals"
config/description="Beat 'em up em pixel art. Protótipo mecânico (etapa 2)."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/settings.gd"
SoundBank="*res://scripts/sound_bank.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/stretch/scale_mode.mobile="fractional"
window/stretch/scale_mode.web="fractional"

[gui]

theme/default_font_antialiasing=0

